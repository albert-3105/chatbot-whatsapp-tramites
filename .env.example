# ── Bot ──────────────────────────────────────────────
BOT_NAME=S.I.S.I
# Número(s) de WhatsApp del/los administrador(es), separados por coma
# si son varios. Formato: código de país + número, sin "+" ni espacios.
ADMIN_NUMBER=573000000000
DATA_DIR=./data
REQUIRE_DATA_CONSENT=true
ANTI_SPAM_DELAY_MS=1200
ADVISOR_TIMEOUT_MS=900000

# ── Cierre automático por inactividad (ciudadanos) ──
# 1800000 ms = 30 minutos
CITIZEN_INACTIVITY_MS=1800000

# ── Cola de mensajes salientes (reduce riesgo de bloqueo) ──
QUEUE_MIN_DELAY_MS=1500
QUEUE_MAX_DELAY_MS=4000
QUEUE_HOURLY_SOFT_CAP=120

# ── Google (cuenta de servicio) ─────────────────────
# NUNCA pongas estos valores reales en este archivo .env.example,
# solo en tu .env local (que está en .gitignore).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
